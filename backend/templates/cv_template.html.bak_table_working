<!DOCTYPE html>
<html lang="{{ language | default('es') }}">

<head>
    <meta charset="UTF-8">
    <title>{{ basic_info.name }} - CV</title>
    <style>
        @page {
            size: A4;
            margin: 0;
        }

        :root {
            --primary-bg: #ffffff;
            --sidebar-bg: #eceff2;
            --banner-bg: #d1dae3;
            --text-main: #333333;
            --text-light: #444444;
            --accent: #2c3e50;
            --border: #cccccc;
        }

        * {
            box-sizing: border-box;
        }

        body {
            /* Force Arial/Helvetica for maximum PDF safety on Windows */
            font-family: Arial, Helvetica, sans-serif;
            color: var(--text-main);
            background: var(--primary-bg);
            line-height: 1.4;
            font-size: 10pt;
            margin: 0;
            padding: 0;
        }

        /* Main Container Table */
        table.layout-table {
            width: 100%;
            border-collapse: collapse;
            border: none;
            table-layout: fixed;
            /* Important for WeasyPrint */
        }

        td.sidebar-cell {
            width: 32%;
            vertical-align: top;
            background-color: var(--sidebar-bg);
            padding: 20px 15px;
            border-right: 1px solid var(--border);
        }

        td.content-cell {
            width: 68%;
            vertical-align: top;
            padding: 25px 30px;
            background-color: var(--primary-bg);
        }

        /* Header (Simulated in a separate div or table row if needed, but keeping it simple) */
        .header-container {
            background-color: var(--banner-bg);
            padding: 30px 40px;
            text-align: right;
            border-bottom: 5px solid white;
        }

        .header h1 {
            margin: 0;
            font-size: 24pt;
            text-transform: uppercase;
            color: var(--accent);
            letter-spacing: 1px;
        }

        .header h2 {
            margin: 5px 0 0 0;
            font-size: 14pt;
            font-weight: normal;
            color: var(--text-light);
        }

        /* Sidebar Styles */
        .section-title-sidebar {
            font-size: 11pt;
            font-weight: bold;
            text-transform: uppercase;
            border-bottom: 2px solid var(--border);
            margin-bottom: 10px;
            padding-bottom: 3px;
            color: var(--accent);
            margin-top: 20px;
        }

        .section-title-sidebar:first-child {
            margin-top: 0;
        }

        .contact-row {
            margin-bottom: 8px;
            font-size: 9pt;
        }

        .contact-icon {
            font-weight: bold;
            color: var(--accent);
            margin-right: 5px;
        }

        .sidebar-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar-list li {
            margin-bottom: 10px;
            font-size: 9pt;
        }

        .tool-group {
            margin-bottom: 10px;
            font-size: 9pt;
        }

        .tool-label {
            font-weight: bold;
            display: block;
        }

        /* Content Styles */
        .section-title-main {
            font-size: 14pt;
            font-weight: bold;
            color: var(--accent);
            border-bottom: 1px solid var(--border);
            margin-bottom: 15px;
            padding-bottom: 5px;
            text-transform: uppercase;
            margin-top: 25px;
        }

        .section-title-main:first-child {
            margin-top: 0;
        }

        .profile-text {
            text-align: justify;
            font-size: 10pt;
            margin-bottom: 10px;
        }

        .exp-item {
            margin-bottom: 20px;
            page-break-inside: avoid;
        }

        .exp-role {
            font-weight: bold;
            font-size: 11pt;
            color: var(--accent);
        }

        .exp-company {
            font-weight: bold;
            font-size: 11pt;
            color: var(--text-main);
        }

        .exp-date {
            font-size: 9pt;
            color: var(--text-light);
            margin-bottom: 5px;
            font-style: italic;
        }

        .exp-details p {
            margin: 3px 0;
            font-size: 10pt;
        }

        .ref-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .ref-table td {
            vertical-align: top;
            width: 50%;
            padding-right: 10px;
            font-size: 9pt;
        }

        a {
            color: inherit;
            text-decoration: none;
        }
    </style>
</head>

<body>
    <!-- Full Page Container -->
    <div style="width: 100%; overflow: hidden;">

        <!-- Header Section -->
        <div class="header-container">
            <h1>{{ basic_info.name }}</h1>
            <h2>{{ basic_info.title | default("Software Engineer") }}</h2>
        </div>

        <!-- Main Layout Table -->
        <table class="layout-table">
            <tr>
                <!-- COLUMN 1: SIDEBAR -->
                <td class="sidebar-cell">

                    <!-- Contact -->
                    <div class="section-title-sidebar">Contact</div>
                    <div class="contact-row">
                        <span class="contact-icon">📞</span> {{ basic_info.phone | default("+57 30426212096") }}
                    </div>
                    <div class="contact-row">
                        <span class="contact-icon">@</span> {{ basic_info.email }}
                    </div>
                    <div class="contact-row">
                        {% if basic_info.portfolio_url %}<a href="{{ basic_info.portfolio_url }}">Portfolio</a> | {%
                        endif %}
                        {% if basic_info.linkedin_url %}<a href="{{ basic_info.linkedin_url }}">LinkedIn</a>{% endif %}
                    </div>

                    <!-- Education -->
                    <div class="section-title-sidebar">{{ "EDUCATION" if language == "en" else "EDUCACIÓN" }}</div>
                    <ul class="sidebar-list">
                        {% for edu in education %}
                        <li>
                            <strong>{{ edu.degree }}</strong><br>
                            {{ edu.institution }}<br>
                            <span style="color:var(--text-light)">{{ edu.year }}</span>
                        </li>
                        {% endfor %}
                    </ul>

                    <!-- Certifications -->
                    {% if certifications %}
                    <div class="section-title-sidebar">{{ "CERTIFICATIONS" if language == "en" else "CERTIFICACIONES" }}
                    </div>
                    <ul class="sidebar-list">
                        {% for cert in certifications %}
                        <li>
                            <strong>{{ cert.name }}</strong><br>
                            {{ cert.issuer | default(cert.organization) }}<br>
                            <span style="color:var(--text-light)">{{ cert.year | default(cert.date) }}</span>
                        </li>
                        {% endfor %}
                    </ul>
                    {% endif %}

                    <!-- Skills -->
                    <div class="section-title-sidebar">{{ "SKILLS" if language == "en" else "HABILIDADES" }}</div>
                    {% if skills.backend %}
                    <div class="tool-group">
                        <span class="tool-label">Backend</span>
                        {{ skills.backend | join(', ') }}
                    </div>
                    {% endif %}
                    {% if skills.frontend %}
                    <div class="tool-group">
                        <span class="tool-label">Frontend</span>
                        {{ skills.frontend | join(', ') }}
                    </div>
                    {% endif %}
                    {% if skills.databases %}
                    <div class="tool-group">
                        <span class="tool-label">Databases</span>
                        {{ skills.databases | join(', ') }}
                    </div>
                    {% endif %}
                    {% if skills.cloud %}
                    <div class="tool-group">
                        <span class="tool-label">Cloud</span>
                        {{ skills.cloud | join(', ') }}
                    </div>
                    {% endif %}

                    <!-- Languages -->
                    <div class="section-title-sidebar">{{ "LANGUAGES" if language == "en" else "IDIOMAS" }}</div>
                    <ul class="sidebar-list">
                        {% for lang in languages %}
                        <li>{{ lang.language }}: {{ lang.level }}</li>
                        {% endfor %}
                    </ul>

                </td>

                <!-- COLUMN 2: MAIN CONTENT -->
                <td class="content-cell">

                    <!-- Profile -->
                    <div class="section-title-main">{{ "PROFESSIONAL SUMMARY" if language == "en" else "PERFIL
                        PROFESIONAL" }}</div>
                    <div class="profile-text">
                        {{ summary }}
                    </div>

                    <!-- Experience -->
                    <div class="section-title-main">{{ "PROJECT EXPERIENCE" if language == "en" else "EXPERIENCIA EN
                        PROYECTOS" }}</div>
                    {% for job in experience %}
                    <div class="exp-item">
                        <div class="exp-role">{{ job.role }}</div>
                        <div class="exp-company">{{ job.company }}</div>
                        <div class="exp-date">{{ job.duration }}</div>
                        <div class="exp-details">
                            {% if job.highlights %}
                            {% for highlight in job.highlights %}
                            <p>• {{ highlight | safe }}</p>
                            {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}

                    <!-- References -->
                    <div class="section-title-main">{{ "REFERENCES" if language == "en" else "REFERENCIAS" }}</div>
                    <table class="ref-table">
                        <tr>
                            <td>
                                <strong>Ledi Urrego T.</strong><br>
                                {{ "System Engineering" if language == "en" else "Ingeniería de Sistemas" }}<br>
                                +57 3017676947<br>
                                ledi.urrego@sactrack.com
                            </td>
                            <td>
                                <strong>Monica Quintero</strong><br>
                                {{ "Financial Engineer" if language == "en" else "Ingeniera Financiera" }}<br>
                                +57 3102583867<br>
                                monica.quintero@sdsline.com
                            </td>
                        </tr>
                    </table>

                </td>
            </tr>
        </table>
    </div>
</body>

</html>